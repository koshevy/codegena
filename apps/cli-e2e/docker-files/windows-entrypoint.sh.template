#!/bin/sh
set -eu

rm -f "$WIN_INIT_COMPLETE_FILE"
mkdir -p "$WINEPREFIX"
cp -r /opt/wineprefix_template/. "$WINEPREFIX"
wineserver -p
wine cmd /c "xcopy ${WIN_NODE_FROM_DIR} ${WIN_NODE_DIR} /e /i /h /q /y"
wine cmd /c "xcopy Z:\\opt\\e2e ${WIN_WORKDIR} /e /i /q /y"
node --version
touch "$WIN_INIT_COMPLETE_FILE"
exec tail -f /dev/null
