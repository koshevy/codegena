COMPOSE_PROGRESS=auto
COMPOSE_PROJECT_NAME=codegena-uat
LANDING_SSR_IMAGE=${LANDING_SSR_IMAGE}
LANDING_CADDY_IMAGE=${LANDING_CADDY_IMAGE}
LANDING_PLATFORM=linux/amd64
LANDING_RESTART_POLICY=unless-stopped
CADDY_VERSION=2.11.9
BUN_VERSION=1
LANDING_SSR_HOST=0.0.0.0
LANDING_SSR_PORT=8104
CADDY_BIND_ADDRESS=0.0.0.0
CADDY_HTTPS_PORT=443
CADDY_SITE_NAMES="localhost, 127.0.0.1, ${UAT_HOSTNAME}"
CADDY_IP_ADDRESS=${CADDY_IP_ADDRESS}
CADDY_IP_TLS_SNIPPET=public_ip_tls
