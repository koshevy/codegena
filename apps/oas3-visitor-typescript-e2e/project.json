{
  "name": "oas3-visitor-typescript-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/oas3-visitor-typescript-e2e/src",
  "tags": ["application:backend"],
  "implicitDependencies": ["@codegena/oas3-visitor-typescript"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "dependsOn": ["^build"],
      "options": {
        "cwd": "apps/oas3-visitor-typescript-e2e",
        "command": "jest --config jest.config.cts --runInBand"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/oas3-visitor-typescript-e2e",
        "command": "tsc --noEmit -p tsconfig.spec.json"
      }
    }
  }
}
