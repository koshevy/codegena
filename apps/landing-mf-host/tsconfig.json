{
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs",
      "target": "es2022"
    },
    "moduleTypes": {
      "tools/**/*.ts": "cjs",
      "../../packages/**/*.ts": "cjs"
    },
    "require": ["tsconfig-paths/register"]
  },
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    },
    {
      "path": "./tsconfig.storybook.json"
    }
  ],
  "extends": "../../tsconfig.base.json"
}
