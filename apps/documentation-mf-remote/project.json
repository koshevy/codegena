{
  "name": "documentation-mf-remote",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/documentation-mf-remote/src",
  "projectType": "application",
  "tags": ["mf:remote"],
  "targets": {
    "serve": {
      "dependsOn": ["@codegena/source:apply-dependency-patches"],
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "docusaurus start --port 8103 --host 127.0.0.1 --no-open",
        "cwd": "apps/documentation-mf-remote"
      },
      "configurations": {
        "e2e": {
          "command": "docusaurus start --port 8113 --host 127.0.0.1 --no-open"
        }
      }
    },
    "build": {
      "dependsOn": ["@codegena/source:apply-dependency-patches"],
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^default",
        { "env": "CODEGENA_BUILD_ID" }
      ],
      "options": {
        "command": "docusaurus build --out-dir ../../dist/apps/documentation-mf-remote",
        "cwd": "apps/documentation-mf-remote"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "continuous": true,
      "dependsOn": ["build"],
      "options": {
        "staticFilePath": "dist/apps/documentation-mf-remote",
        "port": 8113,
        "host": "127.0.0.1",
        "watch": false,
        "spa": false
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint . && stylelint \"src/**/*.styles.tsx\"",
        "cwd": "apps/documentation-mf-remote"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.app.json",
        "cwd": "apps/documentation-mf-remote"
      }
    }
  }
}
