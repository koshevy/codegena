{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node", "@docusaurus/module-type-aliases", "@docusaurus/theme-classic"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "docusaurus.config.ts", "sidebars.ts"],
  "exclude": ["src/**/*.stories.tsx", "src/**/*.spec.ts", "src/**/__mocks__/**"]
}
