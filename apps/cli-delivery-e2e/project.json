{
  "name": "cli-delivery-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/cli-delivery-e2e/src",
  "tags": ["application:backend"],
  "implicitDependencies": [
    "@codegena/oas3-core",
    "@codegena/oas3-visitor-typescript",
    "@codegena/playground-ui",
    "playground-mf-remote"
  ],
  "targets": {
    "docker-compose-build": {
      "executor": "@codegena/infr-docker-compose:build",
      "cache": false,
      "dependsOn": ["^build"]
    },
    "docker-compose-up": {
      "executor": "@codegena/infr-docker-compose:up",
      "cache": false,
      "dependsOn": ["docker-compose-build"],
      "options": { "detached": true }
    },
    "e2e": {
      "executor": "@nx/jest:jest",
      "cache": false,
      "dependsOn": ["docker-compose-build"],
      "options": {
        "jestConfig": "apps/cli-delivery-e2e/jest.config.ts",
        "runInBand": true
      }
    },
    "test": {
      "cache": false,
      "dependsOn": ["docker-compose-build"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/cli-delivery-e2e",
        "command": "tsc --noEmit -p tsconfig.spec.json"
      }
    }
  }
}
