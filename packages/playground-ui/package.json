{
  "name": "@codegena/playground-ui",
  "version": "0.0.1",
  "type": "module",
  "main": "./index.esm.js",
  "module": "./index.esm.js",
  "types": "./index.d.ts",
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "tags": [
      "ui:publishable"
    ],
    "targets": {
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/playground-ui",
          "command": "eslint . && stylelint \"{appearance,clipboard,converting-placeholder,download-files,generated-file-details,generated-files-list,graph-utils,json-editor,misc-ui,navigation,playground,preferences,search,src}/**/*.{js,jsx,ts,tsx}\""
        }
      },
      "build": {
        "outputs": [
          "{workspaceRoot}/dist/playground-ui"
        ]
      },
      "storybook": {
        "dependsOn": ["@codegena/source:apply-dependency-patches"]
      },
      "build-storybook": {
        "dependsOn": ["@codegena/source:apply-dependency-patches"],
        "inputs": [
          "production",
          "^production",
          "{projectRoot}/.storybook/**/*",
          {
            "env": "CODEGENA_BUILD_ID"
          },
          {
            "externalDependencies": [
              "storybook"
            ]
          }
        ]
      },
      "storybook-e2e": {
        "dependsOn": ["@codegena/source:apply-dependency-patches"],
        "continuous": true,
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/playground-ui",
          "command": "storybook dev --port=6006 --host=127.0.0.1 --ci --exact-port"
        }
      }
    }
  },
  "dependencies": {
    "@codegena/graph-core": "*",
    "@codegena/graph-search-core": "*",
    "@codegena/graph-search-ui": "*",
    "@codegena/graph-ui": "*",
    "@codegena/notification-ui-core": "*",
    "@codegena/ui-theme": "*",
    "@codegena/ui-unified": "*",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@codegena/infr-nx": "*",
    "@codegena/notification-ui-notistack": "*",
    "@codegena/oas3-visitor-typescript": "*",
    "@codegena/pwa": "*",
    "@nx/react": "23.3.2",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/react": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "eslint": "^10.13.0",
    "nx": "23.3.2",
    "rollup": "^4.14.0",
    "storybook": "10.6.7",
    "stylelint": "^17.16.0",
    "typescript": "6.0.3",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "@codegena/oas3-core": "0.x",
    "@emotion/react": "11.x",
    "@emotion/styled": "11.x",
    "@monaco-editor/react": "4.x",
    "@mui/material": "5.x",
    "@mui/x-tree-view": "8.x",
    "@tanstack/react-virtual": "3.x",
    "clsx": "2.x",
    "jsonc-parser": "3.x",
    "lucide-react": "1.x",
    "monaco-editor": "0.x",
    "react": "19.x",
    "react-dom": "19.x",
    "react-resizable-panels": "4.x"
  }
}
