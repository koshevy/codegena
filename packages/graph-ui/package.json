{
  "name": "@codegena/graph-ui",
  "version": "0.0.1",
  "type": "module",
  "main": "./index.esm.js",
  "module": "./index.esm.js",
  "types": "./index.d.ts",
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "tags": [
      "ui:publishable"
    ],
    "targets": {
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/graph-ui",
          "command": "eslint . && stylelint \"src/**/*.{js,jsx,ts,tsx}\""
        }
      },
      "build": {
        "outputs": [
          "{workspaceRoot}/dist/graph-ui"
        ]
      },
      "storybook": {
        "dependsOn": ["@codegena/source:apply-dependency-patches"]
      },
      "build-storybook": {
        "dependsOn": ["@codegena/source:apply-dependency-patches"]
      }
    }
  },
  "dependencies": {
    "@codegena/graph-core": "*",
    "@codegena/ui-unified": "*",
    "elkjs": "^0.12.0"
  },
  "devDependencies": {
    "@codegena/infr-nx": "*",
    "@codegena/oas3-visitor-typescript": "*",
    "@codegena/ui-theme": "*",
    "@nx/jest": "23.3.2",
    "@nx/react": "23.3.2",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/react": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@swc/core": "1.15.8",
    "@swc/jest": "~0.2.38",
    "@types/jest": "~30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "eslint": "^10.13.0",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "nx": "23.3.2",
    "rollup": "^4.14.0",
    "storybook": "10.6.7",
    "stylelint": "^17.16.0",
    "ts-jest": "^29.4.7",
    "typescript": "6.0.3",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "@codegena/oas3-core": "0.x",
    "@emotion/react": "11.x",
    "@emotion/styled": "11.x",
    "@mui/material": "5.x",
    "@xyflow/react": "12.x",
    "clsx": "2.x",
    "lucide-react": "1.x",
    "react": "19.x",
    "react-dom": "19.x"
  }
}
