{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$dynamicRef": "#product",
  "$defs": {
    "Product": {
      "$dynamicAnchor": "product",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["active", "discontinued"]
        },
        "related": { "$dynamicRef": "#product" }
      },
      "required": ["status"]
    }
  }
}
