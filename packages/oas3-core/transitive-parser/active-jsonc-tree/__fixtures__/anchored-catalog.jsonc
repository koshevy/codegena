{
  "$id": "https://example.com/catalog.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$anchor": "catalog",
  "catalog$anchor": "notAnAnchor",
  "default": { "$anchor": "exampleOnly" },
  "type": "object",
  "properties": {
    "currentProduct": { "$ref": "#product" },
    "archivedProducts": {
      "type": "array",
      "items": {
        "$anchor": "archivedProduct",
        "type": "object",
        "properties": {
          "sku": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "Product": {
      "$anchor": "product",
      "type": "object",
      "properties": {
        "sku": { "type": "string" }
      }
    },
    "ExpandableProduct": {
      "$dynamicAnchor": "expandableProduct",
      "$ref": "#product"
    }
  }
}
