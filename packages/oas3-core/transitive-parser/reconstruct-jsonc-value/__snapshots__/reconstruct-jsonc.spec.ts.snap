{
  "$defs": {
    "customerProfile": {
      "properties": {
        "email": {
          "format": "email",
          "type": "string",
        },
        "id": {
          "minimum": 1,
          "type": "integer",
        },
        "shippingAddress": {
          "properties": {
            "city": {
              "type": "string",
            },
            "country": {
              "maxLength": 3,
              "type": "string",
            },
            "postalCode": {
              "type": "string",
            },
            "street": {
              "minLength": 5,
              "type": "string",
            },
          },
          "required": [
            "street",
            "city",
            "country",
            "postalCode",
          ],
          "type": "object",
        },
      },
      "required": [
        "id",
        "email",
        "shippingAddress",
      ],
      "type": "object",
    },
    "orderItem": {
      "properties": {
        "price": {
          "exclusiveMinimum": 0,
          "type": "number",
        },
        "quantity": {
          "maximum": 99,
          "minimum": 1,
          "type": "integer",
        },
        "sku": {
          "pattern": "^[A-Z]{3}-[0-9]{5}$",
          "type": "string",
        },
      },
      "required": [
        "sku",
        "quantity",
        "price",
      ],
      "type": "object",
    },
    "paymentDetails": {
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "credit_card",
              },
            },
          },
          "then": {
            "properties": {
              "cardToken": {
                "pattern": "^tok_[a-z0-9]{24}$",
                "type": "string",
              },
            },
            "required": [
              "cardToken",
            ],
          },
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "crypto",
              },
            },
          },
          "then": {
            "properties": {
              "currency": {
                "enum": [
                  "BTC",
                  "ETH",
                  "USDC",
                ],
              },
              "walletAddress": {
                "minLength": 26,
                "type": "string",
              },
            },
            "required": [
              "walletAddress",
              "currency",
            ],
          },
        },
      ],
      "properties": {
        "amount": {
          "minimum": 0.01,
          "type": "number",
        },
        "method": {
          "enum": [
            "credit_card",
            "paypal",
            "crypto",
          ],
          "type": "string",
        },
      },
      "required": [
        "method",
        "amount",
      ],
      "type": "object",
    },
  },
  "$id": "https://example.com",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "description": "Conditional Rule: If country is US, require a 5-digit zip code.",
      "if": {
        "properties": {
          "customer": {
            "properties": {
              "shippingAddress": {
                "properties": {
                  "country": {
                    "const": "US",
                  },
                },
              },
            },
          },
        },
      },
      "then": {
        "properties": {
          "customer": {
            "properties": {
              "shippingAddress": {
                "properties": {
                  "postalCode": {
                    "pattern": "^[0-9]{5}$",
                  },
                },
              },
            },
          },
        },
      },
    },
  ],
  "description": "A complex e-commerce order validation schema.",
  "properties": {
    "customer": {
      "$ref": "#/$defs/customerProfile",
    },
    "items": {
      "items": {
        "$ref": "#/$defs/orderItem",
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true,
    },
    "metadata": {
      "additionalProperties": {
        "type": "string",
      },
      "type": "object",
    },
    "orderId": {
      "description": "Unique order tracking ID matching format ORD-YYYY-XXXXXX.",
      "pattern": "^ORD-[0-9]{4}-[A-Z0-9]{6}$",
      "type": "string",
    },
    "payment": {
      "$ref": "#/$defs/paymentDetails",
    },
  },
  "required": [
    "orderId",
    "customer",
    "items",
    "payment",
  ],
  "title": "ComplexOrderSchema",
  "type": "object",
}
`;

