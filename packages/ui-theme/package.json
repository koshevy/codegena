{
  "name": "@codegena/ui-theme",
  "version": "0.0.1",
  "type": "module",
  "main": "./index.esm.js",
  "module": "./index.esm.js",
  "types": "./index.d.ts",
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "assets/",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "tags": [
      "ui:publishable"
    ],
    "targets": {
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/ui-theme",
          "command": "eslint . && stylelint \"src/**/*.{js,jsx,ts,tsx}\""
        }
      },
      "build": {
        "outputs": [
          "{workspaceRoot}/dist/ui-theme"
        ]
      }
    }
  },
  "devDependencies": {
    "@codegena/infr-nx": "*",
    "@nx/jest": "23.3.2",
    "@nx/react": "23.3.2",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/react": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@swc/core": "1.15.8",
    "@swc/jest": "~0.2.38",
    "@types/jest": "~30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "eslint": "^10.13.0",
    "jest": "~30.3.0",
    "nx": "23.3.2",
    "rollup": "^4.14.0",
    "storybook": "10.6.7",
    "stylelint": "^17.16.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@emotion/react": "11.x",
    "@emotion/styled": "11.x",
    "@mui/material": "5.x",
    "@mui/system": "5.x",
    "react": "19.x",
    "react-dom": "19.x"
  }
}
