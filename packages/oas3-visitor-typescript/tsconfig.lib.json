{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "cli/**/*.ts", "greeting/**/*.ts"],
  "exclude": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "src/**/__mocks__/**",
    "src/**/__fixtures__/**",
    "src/**/__snapshots__/**",
    "src/**/testing-utils/**",
    "cli/**/__fixtures__/**"
  ],
  "nx": {
    "sync": {
      "ignoredDependencies": ["@codegena/infr-nx"]
    }
  }
}
