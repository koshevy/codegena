          "type": "string"
        },
        "cardToken": {
          "type": "string"
        },
        "billingAddress": {
          "$ref": "#/$defs/Address"
        },
        "bankAccount": {
          "type": "string"
        }
      },
      "required": [
        "customerId"
      ],
      "dependentRequired": {
        "cardToken": [
          "billingAddress"
        ],
        "bankAccount": [
          "billingAddress"
        ]
      },
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/Payment"
