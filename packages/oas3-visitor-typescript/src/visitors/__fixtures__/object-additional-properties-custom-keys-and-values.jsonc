{
  "$id": "object-with-additional-properties-custom-keys",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Option propertyNames used to describe groups of objects",
  "type": "object",
  "propertyNames": {
    "pattern": "^GROUP_([A-Z0-9_]+)$"
  },
  "additionalProperties": {
    "type": "object",
    "description": "Custom property sets",
    "propertyNames": {
      "pattern": "^(CORE|EXTENSION)_([A-Z_]+)$"
    }
  }
}
