    "fileName": "vaults/_common/vault.ts",
    "source": "export interface Vault {
  description?: string;
  id?: string;
  name?: string;
  /**
   * The vault version
   */
  attributeVersion?: number;
  /**
   * The version of the vault contents
   */
  contentVersion?: number;
  /**
   * Number of active items in the vault
   */
  items?: number;
  type?: 'USER_CREATED' | 'PERSONAL' | 'EVERYONE' | 'TRANSFER';
  createdAt?: \`\${number}-\${number}-\${number}T\${number}:\${number}:\${number}\${string}\`;
  updatedAt?: \`\${number}-\${number}-\${number}T\${number}:\${number}:\${number}\${string}\`;
}",
