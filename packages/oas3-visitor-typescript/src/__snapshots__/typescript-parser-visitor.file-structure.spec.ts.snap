  {
    "fileName": "items/_common/field.ts",
    "source": "import type { GeneratorRecipe } from './generator-recipe';

export interface Field {
  id: string;
  type:
    'STRING' | 'EMAIL' | 'CONCEALED' | 'URL' | 'TOTP' | 'DATE' | 'MONTH_YEAR' | 'MENU';
  section?: {
    id?: string;
  };
  /**
   * Some item types, Login and Password, have fields used for autofill. This
   * property indicates that purpose and is required for some item types.
   */
  purpose?: '' | 'USERNAME' | 'PASSWORD' | 'NOTES';
  label?: string;
  value?: string;
  /**
   * If value is not present then a new value should be generated for this
   * field
   */
  generate?: boolean;
  recipe?: GeneratorRecipe;
  /**
   * For fields with a purpose of \`PASSWORD\` this is the entropy of the value
   */
  entropy?: number;
}",
  },
  {
    "fileName": "items/_common/full-item.ts",
    "source": "import type { Item } from './item';
import type { Field } from './field';
import type { File } from '../../_common/file';

export type FullItem = Item & {
  sections?: {
    id?: string;
    label?: string;
  }[];
  fields?: Field[];
  files?: File[];
};",
  },
  {
    "fileName": "items/_common/generator-recipe.ts",
    "source": "/**
 * The recipe is used in conjunction with the "generate" property to set the
 * character set used to generate a new secure value
 */
export interface GeneratorRecipe {
  /**
   * Length of the generated value
   */
  length?: number;
  characterSets?: ('LETTERS' | 'DIGITS' | 'SYMBOLS')[];
  /**
   * List of all characters that should be excluded from generated passwords.
   */
  excludeCharacters?: string;
}",
  },
