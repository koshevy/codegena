  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "nx": {
    "targets": {
      "apply-dependency-patches": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "commands": [
            "patch-package --patch-dir apps/landing-mf-host/patches --error-on-fail",
            "patch-package --patch-dir apps/documentation-mf-remote/patches --error-on-fail",
            "patch-package --patch-dir packages/oas3-visitor-typescript/patches --error-on-fail"
          ],
          "parallel": false
        }
      },
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    }
  },
